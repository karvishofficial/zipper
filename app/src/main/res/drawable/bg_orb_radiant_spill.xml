<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Radiant Ethereal Ambient Halo spilling onto pitch black floor -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="#8000F0FF"
                android:centerColor="#352563EB"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Outer Concentric Electric Cyan Laser Ring -->
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="20dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#9938BDF8" />
            <solid android:color="#0D00F0FF" />
        </shape>
    </item>

    <!-- Inner Luminous High-Intensity Core Laser Ring -->
    <item
        android:left="32dp"
        android:right="32dp"
        android:top="28dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <stroke
                android:width="2.5dp"
                android:color="#FF00F0FF" />
            <solid android:color="#3500D2FF" />
        </shape>
    </item>
</layer-list>
