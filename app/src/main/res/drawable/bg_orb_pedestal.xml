<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft halo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#2A1D4ED8"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Outer neon ring -->
    <item android:top="20dp" android:bottom="20dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#4438BDF8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Core glowing disc -->
    <item android:top="32dp" android:bottom="32dp" android:left="28dp" android:right="28dp">
        <shape android:shape="oval">
            <stroke android:width="1.8dp" android:color="#8838BDF8" />
            <solid android:color="#E0060913" />
        </shape>
    </item>
</layer-list>
