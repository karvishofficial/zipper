<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_clean_white"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Checkbox, Details & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Interactive Checkbox Frame -->
        <FrameLayout
            android:id="@+id/flChecklistCheckbox"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivChecklistCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_circle_outline"
                app:tint="#9CA3AF" />
        </FrameLayout>

        <!-- Main Task Text Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Category & Source Pill Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChecklistCategoryPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="📞 Callback"
                    android:textColor="#2563EB"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Priority Badge Pill -->
                <TextView
                    android:id="@+id/tvChecklistPriorityPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:backgroundTint="#FEE2E2"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="URGENT"
                    android:textColor="#DC2626"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChecklistSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="• Bhavani"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Task Title -->
            <TextView
                android:id="@+id/tvChecklistTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Return call to Bhavani"
                android:textColor="#111827"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Original Message Prior / Quote Box -->
            <LinearLayout
                android:id="@+id/llChecklistMessageQuoteBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_clean_blue"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvChecklistMessageQuote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:text="“Manoj: Bro message to Ajay that I am not coming”"
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Subtitle / Notes / Reason -->
            <TextView
                android:id="@+id/tvChecklistNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="1dp"
                android:text="Missed call earlier; return call regarding project materials."
                android:textColor="#4B5563"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Candidate Apps Row (Full Width Scrollable) -->
    <LinearLayout
        android:id="@+id/llChecklistCandidateAppsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/hsvChecklistCandidateApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llChecklistCandidateApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Action Buttons Row (Call Now / Auto-Do / Mark Done) -->
    <LinearLayout
        android:id="@+id/llChecklistActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Call Now Button -->
        <LinearLayout
            android:id="@+id/btnChecklistCallNow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_call_circle"
            android:backgroundTint="#10B981"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_bolt"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-bold"
                android:text="Call Now"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Auto-Do Button -->
        <LinearLayout
            android:id="@+id/btnChecklistAutoDo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_send_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivChecklistAutoDoIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_bolt"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvChecklistAutoDoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-bold"
                android:text="⚡ Auto-Do"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Toggle Done Button -->
        <TextView
            android:id="@+id/btnChecklistToggleDone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_app_pill_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✓ Mark Done"
            android:textColor="#4B5563"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
