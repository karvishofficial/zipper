<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:orientation="vertical"
        android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delegate Contact to AI"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Answers WhatsApp/SMS in your tone via connected LLM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoReplyEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#1E293B" />

    <!-- Configured Contacts Selector (if any exist) -->
    <LinearLayout
        android:id="@+id/llConfiguredContactsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIGURED CONTACTS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llConfiguredContactChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Contact Name Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTACT NAME (AS SHOWN IN WHATSAPP)"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContactName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box_light"
        android:backgroundTint="#1E293B"
        android:hint="e.g. Manoj, Client Sarah, Mom"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="14sp" />

    <!-- Optional Phone Digits -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="OPTIONAL PHONE NUMBER (FOR EXACT MATCHING)"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContactPhone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box_light"
        android:backgroundTint="#1E293B"
        android:hint="e.g. +91 9876543210"
        android:inputType="phone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp" />

    <!-- Context & Instructions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="WHAT SHOULD THE AI TELL THEM? (YOUR SITUATION)"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCustomContext"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_box_light"
        android:backgroundTint="#1E293B"
        android:gravity="top|start"
        android:hint="e.g. I am in a client meeting until 5 PM. The build is ready and verified, will send APK after."
        android:padding="12dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp" />

    <!-- Quick Status Presets -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipPresetMeeting"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="💼 Meeting till 5"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipPresetDriving"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🚗 Driving"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipPresetGym"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🏋️ At Gym"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipPresetTravel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✈️ Traveling"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Tone Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="AI PERSONA TONE"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/chipToneCasual"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="😎 Casual"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/chipTonePro"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="👔 Pro"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/chipToneBrief"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⚡ Short"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Loop Protection & Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Anti-Loop Safety Budget:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMaxRepliesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_pill_black"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Max 3 replies / session"
            android:textColor="#38BDF8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Connected LLM Brain Section -->
    <LinearLayout
        android:id="@+id/llAiConfigSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_filter_pill_black"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAiEngineStatusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧠 Connected LLM Brain"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiKeyStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Key Needed"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etAiApiKey"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_box_light"
            android:backgroundTint="#0F172A"
            android:hint="Paste Gemini / Groq / OpenAI API key..."
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Primary LLM brain. Auto-inherits your Gemini key from Zipper."
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />

        <!-- Secondary Fallback Key Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ Backup Fallback Key"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiFallbackStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional (Groq/OpenAI)"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etAiFallbackApiKey"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box_light"
            android:backgroundTint="#0F172A"
            android:hint="Optional Groq (gsk_...) or OpenAI backup key..."
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Remote Command Security Password / PIN Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_filter_pill_black"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔐 Remote Command Password / PIN"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRemotePinStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1234"
                android:textColor="#F59E0B"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etRemoteSecurityPin"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box_light"
            android:backgroundTint="#0F172A"
            android:hint="Enter password or PIN (e.g. 1234)"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Used for remote control actions (e.g. #1234: ring, #1234 battery)"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbRequireApproval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Require 1-tap notification preview before sending"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbAppendAiBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Append '— Sent via Zipper AI' badge to replies"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Clear Chat History / Fresh Start Section -->
    <LinearLayout
        android:id="@+id/llClearHistorySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_filter_pill_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Chat Memory &amp; Context"
                android:textColor="#F8FAFC"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatHistoryTurnsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wipe stored turns to start a completely fresh conversation"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearChatHistory"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="Clear History"
            android:textColor="#F87171"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeleteContact"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Delete"
            android:textColor="#EF4444"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCancelContact"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnSaveContact"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0284C7"
            android:text="Save &amp; Allow 🚀"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    </LinearLayout>

</ScrollView>
