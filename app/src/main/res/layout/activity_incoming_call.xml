<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_incoming_call_daylight"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svCallContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

        <!-- ============================================================= -->
        <!-- 1. TOP HEADER                                                 -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCallStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Karvish is calling you"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Sparkle"
                android:src="@drawable/ic_sparkle"
                app:tint="#2563EB" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Task Reminder"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- ============================================================= -->
        <!-- 2. HERO AVATAR & RIPPLE PULSE                                 -->
        <!-- ============================================================= -->
        <FrameLayout
            android:id="@+id/flHeroAvatarContainer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Dual Animated Concentric Ripples -->
            <View
                android:id="@+id/vAvatarPulse2"
                android:layout_width="186dp"
                android:layout_height="186dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_ripple_ring" />

            <View
                android:id="@+id/vAvatarPulse"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_ripple_ring" />

            <!-- Circular Mascot Frame -->
            <androidx.cardview.widget.CardView
                android:layout_width="134dp"
                android:layout_height="134dp"
                android:layout_gravity="center"
                app:cardCornerRadius="67dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/ivAvatarMascot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Karvish Mascot"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_karvish_call_avatar" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Caller Identity -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Karvish"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Sparkle"
                android:src="@drawable/ic_sparkle"
                app:tint="#2563EB" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceEngineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Personal Action Assistant"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- ============================================================= -->
        <!-- 3. CARD 1: CALLING ABOUT (GOAL & DUE)                        -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/cardCallingAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_call_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_calendar_orange">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="#D97706" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCallingAboutTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="CALLING ABOUT"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReminderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="Assignment Submission"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReminderDue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="Due tomorrow • DBMS (Module 4)"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- 3B. CARD: ORIGINAL INCOMING MESSAGE                           -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/cardOriginalMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_call_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Chat"
                    android:src="@drawable/ic_chat"
                    app:tint="#16A34A" />

                <TextView
                    android:id="@+id/tvOriginalMessageHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="INCOMING MESSAGE"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOriginalMessageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- 4. CARD 2: SPOKEN TRANSCRIPT (AUDIO DIALOGUE)                -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/cardTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_call_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivVoiceWaveform"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Audio Wave"
                android:src="@drawable/ic_audio_wave"
                app:tint="#2563EB" />

            <TextView
                android:id="@+id/tvReminderPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:text="“Hey Karthik, your DBMS assignment is due tomorrow. Do you want to work on it now or should I reschedule it?”"
                android:textColor="#334155"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- 5. CARD 3: QUICK ACTION PILLS (START NOW / SNOOZE / RESCHED) -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/llQuickActionPills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Pill 1: Start Now -->
            <LinearLayout
                android:id="@+id/btnQuickStartNow"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_call_action_pill"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Start"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#2563EB" />

                <TextView
                    android:id="@+id/tvQuickStartNowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Start now"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Pill 2: Snooze 30 min -->
            <LinearLayout
                android:id="@+id/btnQuickSnooze"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_call_action_pill"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Snooze"
                    android:src="@drawable/ic_clock"
                    app:tint="#475569" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuickSnoozeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:text="Snooze"
                        android:textColor="#1E293B"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuickSnoozeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="30 min"
                        android:textColor="#64748B"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pill 3: Reschedule -->
            <LinearLayout
                android:id="@+id/btnQuickReschedule"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_call_action_pill"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Reschedule"
                    android:src="@drawable/ic_calendar"
                    app:tint="#2563EB" />

                <TextView
                    android:id="@+id/tvQuickRescheduleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:text="Reschedule ›"
                    android:textColor="#1E293B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Interactive In-Call Custom Message Input -->
        <LinearLayout
            android:id="@+id/llCallCustomInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_call_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Type reply"
                    android:src="@drawable/ic_tune"
                    app:tint="#2563EB" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="OR TYPE CUSTOM REPLY"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_call_action_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="2dp">

                <EditText
                    android:id="@+id/etCallCustomInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Type reply (e.g. 5 PM ge, clg ide)..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:minHeight="40dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="13.5sp" />

                <FrameLayout
                    android:id="@+id/btnCallCustomSend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_black"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Send Custom Reply"
                        android:src="@drawable/ic_send"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Don't Call Today Quick Action Pill -->
        <TextView
            android:id="@+id/btnDontCallToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_clean_blue"
            android:backgroundTint="#FEE2E2"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="🔕 Don't call me today"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Candidate Apps HUD (Installed Apps for 1-Tap Opening) -->
        <LinearLayout
            android:id="@+id/llCandidateAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_call_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCandidateAppsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.08"
                android:text="OPEN WITH APP"
                android:textColor="#2563EB"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llCandidateAppIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Don't Call Today Action Pill -->
        <TextView
            android:id="@+id/btnCallScreenDontCallToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_clean_blue"
            android:backgroundTint="#FEE2E2"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="🔕 Don't Call Today"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Call Screening Decision Pills Container (Pixel-Style Autonomous Whisperer) -->
        <LinearLayout
            android:id="@+id/llScreeningDecisionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="WHISPER TO CALLER"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:rowCount="2">

                <TextView
                    android:id="@+id/btnScreenPillLeaveAtDoor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="📦 Leave at door"
                    android:textColor="#1E3A8A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnScreenPillCallBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="⏱️ Call in 15m"
                    android:textColor="#1E3A8A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnScreenPillNotInterested"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:backgroundTint="#FEE2E2"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🚫 Not interested"
                    android:textColor="#DC2626"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnScreenPillUrgentRing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:backgroundTint="#FEF3C7"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🚨 Urgent: Ring"
                    android:textColor="#D97706"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </GridLayout>
        </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================================= -->
    <!-- 6. BOTTOM CALL CONTROLS (DECLINE, SCREEN & ANSWER)             -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/llCallActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <!-- Decline Action -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="86dp"
                    android:layout_height="86dp">

                    <View
                        android:id="@+id/vGlowDecline"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:background="@drawable/bg_call_glow_red" />

                    <FrameLayout
                        android:id="@+id/btnDeclineCall"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_call_decline_btn"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="Decline Call"
                            android:src="@drawable/ic_call_end" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDeclineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Decline"
                    android:textColor="#475569"
                    android:textSize="14sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Screen Call Action (Center) -->
            <LinearLayout
                android:id="@+id/llScreenCallContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnScreenCall"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill_clean_blue"
                    android:backgroundTint="#EFF6FF"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🤖"
                        android:textSize="28sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvScreenLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Screen Call"
                    android:textColor="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Answer Action -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="86dp"
                    android:layout_height="86dp">

                    <View
                        android:id="@+id/vGlowAnswer"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:background="@drawable/bg_call_glow_green" />

                    <FrameLayout
                        android:id="@+id/btnAnswerCall"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_call_answer_btn"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="Answer Call"
                            android:src="@drawable/ic_call_answer" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAnswerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Answer"
                    android:textColor="#475569"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
</LinearLayout>
