<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="165dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_product_card_daylight"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Store App Badge (Amazon, Flipkart, Zepto, etc.) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivCardStoreIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_globe"
            app:tint="#4B5563" />

        <TextView
            android:id="@+id/tvCardStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Store"
            android:textColor="#6B7280"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Product Photo -->
    <ImageView
        android:id="@+id/ivCardProductImage"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_image_12"
        android:clipToOutline="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_laptop" />

    <!-- Product Title -->
    <TextView
        android:id="@+id/tvCardProductTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-bold"
        android:maxLines="2"
        android:text="Product Name"
        android:textColor="#111827"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Price Display -->
    <TextView
        android:id="@+id/tvCardProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-black"
        android:text="₹0"
        android:textColor="#111827"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Action Button: View Details -->
    <TextView
        android:id="@+id/btnCardViewDetails"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_filter_pill_light"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:text="View details →"
        android:textColor="#1F2937"
        android:textSize="11.5sp" />
</LinearLayout>
