<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollWebmindPriceTrack"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <!-- ============================================================= -->
        <!-- PRODUCT SUMMARY CARD                                          -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_card_light"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivTrackProdThumbnail"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_filter_pill_light"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_globe" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrackProdTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Tracked Product"
                    android:textColor="#111827"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTrackProdPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="₹62,990"
                        android:textColor="#111827"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="★ 4.5 (1.2K)"
                        android:textColor="#D97706"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrackProdStore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Amazon India"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- PRICE HISTORY GRAPH CARD                                      -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_action_card_light"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Time Filter Chips -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="Price History (Last 3 Months)"
                    android:textColor="#111827"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_filter_pill_light"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1M"
                        android:textColor="#4B5563"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_btn_plus_blue"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="3M"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_filter_pill_light"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="6M"
                        android:textColor="#4B5563"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_filter_pill_light"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1Y"
                        android:textColor="#4B5563"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Custom Bezier Graph View -->
            <com.zipper.app.webmind.ui.PriceGraphView
                android:id="@+id/priceGraphView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- TRACK PRICE CONFIGURATION CARD                                -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_action_card_light"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Track Price"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Notify me when price is:"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <!-- Radio Options -->
            <RadioGroup
                android:id="@+id/rgPriceThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbDropsTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif"
                    android:text="Drops to or below ₹60,000"
                    android:textColor="#111827"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDropsBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Drops by "
                        android:textColor="#111827"
                        android:textSize="12.5sp" />

                    <EditText
                        android:id="@+id/etDropByAmount"
                        android:layout_width="84dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_filter_pill_light"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="₹ 5,000"
                        android:textColor="#111827"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rbGoesAbove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Goes above ₹70,000"
                    android:textColor="#111827"
                    android:textSize="12.5sp" />
            </RadioGroup>

            <!-- Start Tracking Button -->
            <Button
                android:id="@+id/btnStartPriceTracking"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_black_pill"
                android:fontFamily="sans-serif-bold"
                android:text="Start Tracking"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
