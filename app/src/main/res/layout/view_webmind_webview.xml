<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutWebmindWebView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ============================================================= -->
    <!-- BROWSER ADDRESS BAR                                           -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/llBrowserBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBrowserBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="5dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#111827" />

        <LinearLayout
            android:id="@+id/llBrowserUrlPill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_browser_url_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock"
                app:tint="#10B981" />

            <TextView
                android:id="@+id/tvBrowserUrlDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="https://www.amazon.in/dp/B0D1G5Y3Q2"
                android:textColor="#374151"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBrowserShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            app:tint="#4B5563" />

        <ImageButton
            android:id="@+id/btnBrowserDesktopToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Desktop Mode"
            android:padding="6dp"
            android:src="@drawable/ic_laptop"
            app:tint="#4B5563" />

        <ImageButton
            android:id="@+id/btnBrowserRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="#4B5563" />
    </LinearLayout>

    <!-- Live Copilot Smart Header Bar -->
    <LinearLayout
        android:id="@+id/llCopilotSmartBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_below="@id/llBrowserBar"
        android:background="#F8FAFC"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvCopilotShieldStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="🛡️ Shield Active · Ads Blocked"
            android:textColor="#059669"
            android:textSize="11sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnQuickCrossCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_pill_light"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="🛒 Compare Prices"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuickElementZap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_filter_pill_light"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="✂️ Zap Banners"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ambient Deal Radar & Live Intelligence Banner -->
    <LinearLayout
        android:id="@+id/llWebviewDealRadar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llCopilotSmartBar"
        android:background="#FEF3C7"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_trophy"
            app:tint="#D97706" />

        <TextView
            android:id="@+id/tvWebviewDealRadarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="💡 Cheaper deal found: ₹39 on Blinkit vs ₹44 on Zepto"
            android:textColor="#92400E"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnWebviewDealRadarSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_clean_blue"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Switch ↗"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Native Web Browser View -->
    <WebView
        android:id="@+id/webmindMainWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llWebviewDealRadar" />

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/pbWebLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/llCopilotSmartBar"
        android:indeterminate="true"
        android:indeterminateTint="#2563EB"
        android:visibility="gone" />

    <!-- Floating Webview OTP Injector Banner -->
    <LinearLayout
        android:id="@+id/llWebviewOtpBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/pbWebLoading"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud_pill"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvWebviewOtpBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="OTP: 489201 from HDFC Bank"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWebviewInjectOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_pill_black"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="⚡ Auto-Fill"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Live Web Perception & Agent Action HUD (Floating above bottom dock) -->
    <LinearLayout
        android:id="@+id/llWebviewAgentHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llFloatingAiDock"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_hud_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbWebviewAgent"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#2563EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Zipper Live Web Action"
                android:textColor="#111827"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebviewAgentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Perceiving webpage DOM..."
                android:textColor="#2563EB"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- FLOATING BOTTOM AI ACTION DOCK PILL                           -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/llFloatingAiDock"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_ai_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- AI Help -->
        <LinearLayout
            android:id="@+id/btnDockAiHelp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sparkle"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="AI Help"
                android:textColor="#2563EB"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#E5E7EB" />

        <!-- Summarize -->
        <LinearLayout
            android:id="@+id/btnDockSummarize"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_article"
                app:tint="#374151" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Summarize"
                android:textColor="#374151"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#E5E7EB" />

        <!-- Compare -->
        <LinearLayout
            android:id="@+id/btnDockCompare"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_compare"
                app:tint="#374151" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Compare"
                android:textColor="#374151"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#E5E7EB" />

        <!-- Reader Mode -->
        <LinearLayout
            android:id="@+id/btnDockReader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_article"
                app:tint="#374151" />

            <TextView
                android:id="@+id/tvDockReaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Reader"
                android:textColor="#374151"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#E5E7EB" />

        <!-- Element Zapper -->
        <LinearLayout
            android:id="@+id/btnDockZapper"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_bolt"
                app:tint="#DC2626" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Zap"
                android:textColor="#DC2626"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
