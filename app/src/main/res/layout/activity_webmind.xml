<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWebmindLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ============================================================= -->
    <!-- TOP APP BAR                                                   -->
    <!-- ============================================================= -->
    <RelativeLayout
        android:id="@+id/webmindTopBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Arrow (Visible on child screens, hidden or logo on home) -->
            <ImageButton
                android:id="@+id/btnWebmindBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111827" />

            <!-- Globe Icon Badge (Click to open Live WebView) -->
            <ImageView
                android:id="@+id/ivHeaderGlobeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Live Web Browser"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_globe"
                app:tint="#111827" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWebmindTopTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false"
                    android:text="Zipper"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWebmindTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="Research · Compare · Analyze"
                    android:textColor="#6B7280"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Action Icons: Notification Bell & Profile Avatar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- AI Mode Toggle Pill -->
            <TextView
                android:id="@+id/btnWebmindAiToggle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill_black"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚡ AI: ON"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <!-- Bell with Red Dot -->
            <FrameLayout
                android:id="@+id/btnWebmindHeaderBell"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="#111827" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_badge_icon_red" />
            </FrameLayout>

            <!-- User Avatar (K in Cream Circle) -->
            <TextView
                android:id="@+id/tvWebmindHeaderAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_profile_avatar"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="K"
                android:textColor="#92400E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ============================================================= -->
    <!-- MAIN CONTENT CONTAINER (HOLDING 10 SCREENS)                   -->
    <!-- ============================================================= -->
    <FrameLayout
        android:id="@+id/flWebmindContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/webmindBottomNavBar"
        android:layout_below="@id/webmindTopBar">

        <include
            android:id="@+id/screenHome"
            layout="@layout/view_webmind_home"
            android:visibility="visible" />

        <include
            android:id="@+id/screenChat"
            layout="@layout/view_webmind_chat"
            android:visibility="gone" />

        <include
            android:id="@+id/screenWebView"
            layout="@layout/view_webmind_webview"
            android:visibility="gone" />

        <include
            android:id="@+id/screenSplit"
            layout="@layout/view_webmind_split"
            android:visibility="gone" />

        <include
            android:id="@+id/screenCompare"
            layout="@layout/view_webmind_compare"
            android:visibility="gone" />

        <include
            android:id="@+id/screenPriceTrack"
            layout="@layout/view_webmind_price_track"
            android:visibility="gone" />

        <include
            android:id="@+id/screenSummarize"
            layout="@layout/view_webmind_summarize"
            android:visibility="gone" />

        <include
            android:id="@+id/screenHistory"
            layout="@layout/view_webmind_history"
            android:visibility="gone" />

        <include
            android:id="@+id/screenSaved"
            layout="@layout/view_webmind_saved"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ============================================================= -->
    <!-- BOTTOM NAVIGATION DOCK (WARM DAYLIGHT BAR)                    -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/webmindBottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_light"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- TAB 1: Agent (Switches back to MainActivity) -->
        <LinearLayout
            android:id="@+id/navTabAgent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mascot_agent"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Agent"
                android:textColor="#6B7280"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- TAB 2: Webmind (ACTIVE Warm Cream Capsule Pill) -->
        <FrameLayout
            android:id="@+id/navTabWebmind"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.2"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_pill_warm"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_globe"
                    app:tint="#111827" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:text="Webmind"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- TAB 3: Planner (Center) -->
        <LinearLayout
            android:id="@+id/navTabPlanner"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Planner"
                android:textColor="#6B7280"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- TAB 4: Ditto -->
        <LinearLayout
            android:id="@+id/navTabDitto"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_ditto"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ditto"
                android:textColor="#6B7280"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- TAB 4: Control -->
        <LinearLayout
            android:id="@+id/navTabControl"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tune"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Control"
                android:textColor="#6B7280"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
