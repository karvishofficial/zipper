<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_clean_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/ivAttentionAppIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_article"
            app:tint="#2563EB" />

        <TextView
            android:id="@+id/tvAttentionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Email Reply Pending"
            android:textColor="#111827"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <!-- Status Tag Pill (e.g. BLOCKED / REMINDER) -->
        <TextView
            android:id="@+id/tvAttentionTagPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tag_blocked"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="BLOCKED"
            android:textColor="#DC2626"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#9CA3AF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAttentionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="2dp"
        android:text="Requires your confirmation to send the reply."
        android:textColor="#6B7280"
        android:textSize="12.5sp" />

    <!-- Status Time / Waiting row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAttentionStatusIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_clock"
            app:tint="#DC2626" />

        <TextView
            android:id="@+id/tvAttentionStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="Waiting for you"
            android:textColor="#DC2626"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
