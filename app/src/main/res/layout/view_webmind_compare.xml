<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollWebmindCompare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ============================================================= -->
        <!-- SUB-NAVIGATION FILTER TABS                                    -->
        <!-- ============================================================= -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabSubComparison"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_filter_pill_black"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Comparison"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSubSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_light"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Specs"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSubReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_light"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Reviews"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSubPriceHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_light"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Price History"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================= -->
        <!-- 3-COLUMN PRODUCT CARDS & COMPARISON MATRIX                    -->
        <!-- ============================================================= -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Top Row: Product Cards with Thumbnails, Titles, Prices -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Leading Column Header Label Spacer -->
                    <View
                        android:layout_width="76dp"
                        android:layout_height="1dp" />

                    <!-- Product 1 -->
                    <LinearLayout
                        android:id="@+id/llCompareProd1"
                        android:layout_width="112dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_action_card_light"
                        android:elevation="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivCompareProd1"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_globe" />

                        <TextView
                            android:id="@+id/tvCompareProd1Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="Product 1"
                            android:textColor="#111827"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompareProd1Price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text=""
                            android:textColor="#111827"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Product 2 -->
                    <LinearLayout
                        android:id="@+id/llCompareProd2"
                        android:layout_width="112dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_action_card_light"
                        android:elevation="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivCompareProd2"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_globe" />

                        <TextView
                            android:id="@+id/tvCompareProd2Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="Product 2"
                            android:textColor="#111827"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompareProd2Price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text=""
                            android:textColor="#111827"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Product 3 -->
                    <LinearLayout
                        android:id="@+id/llCompareProd3"
                        android:layout_width="112dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_action_card_light"
                        android:elevation="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivCompareProd3"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_globe" />

                        <TextView
                            android:id="@+id/tvCompareProd3Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="Product 3"
                            android:textColor="#111827"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompareProd3Price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text=""
                            android:textColor="#111827"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Comparison Specs Rows -->
                <TableLayout
                    android:id="@+id/tableCompareSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <!-- Row 1: Rating -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Rating" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="★ 4.5 (1.2K)" android:textColor="#D97706" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="★ 4.4 (980)" android:textColor="#D97706" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="112dp" android:text="★ 4.4 (1.1K)" android:textColor="#D97706" android:textSize="11sp" android:textStyle="bold" />
                    </TableRow>

                    <!-- Row 2: Processor -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Processor" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="i5-13450HX" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="i5-13420H" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="i5-12500H" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 3: Graphics -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Graphics" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="RTX 3050" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="RTX 3050" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="RTX 3050" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 4: RAM -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="RAM" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="16 GB" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="16 GB" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="16 GB" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 5: Storage -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Storage" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="512 GB" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="512 GB" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="512 GB" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 6: Display -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Display" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="15.6&quot; 144Hz" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="15.6&quot; 144Hz" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="15.6&quot; 144Hz" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 7: Weight -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Weight" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="2.4 kg" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="2.3 kg" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="2.2 kg" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 8: Battery -->
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:layout_width="76dp" android:text="Battery" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="60 Wh" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:text="70 Wh" android:textColor="#111827" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:text="90 Wh" android:textColor="#111827" android:textSize="11sp" />
                    </TableRow>

                    <!-- Row 9: Best For Badges -->
                    <TableRow>
                        <TextView android:layout_width="76dp" android:text="Best For" android:textColor="#9CA3AF" android:textSize="11sp" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_badge_pill_green" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="Best Overall" android:textColor="#166534" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="112dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_badge_pill_purple" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="Best for Gaming" android:textColor="#7E22CE" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="112dp" android:background="@drawable/bg_badge_pill_teal" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="Best Build" android:textColor="#0F766E" android:textSize="10sp" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================= -->
        <!-- OUR RECOMMENDATION HIGHLIGHT CARD                             -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card_recommendation"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Our Recommendation"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecommendationBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Compare products across web stores to view synthesized recommendation."
                android:textColor="#374151"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Verified Review Sentiment & Pros/Cons Section -->
        <LinearLayout
            android:id="@+id/llCompareReviewsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_action_card_light"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="⭐ Verified Buyer Review Sentiment"
                android:textColor="#111827"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompareReviewPraises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="🟢 Top Praises:"
                android:textColor="#065F46"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCompareReviewComplaints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="🔴 Top Complaints:"
                android:textColor="#991B1B"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
