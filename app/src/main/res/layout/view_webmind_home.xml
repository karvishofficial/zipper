<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollWebmindHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llHomeBottomBar"
        android:background="#F8F9FA"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

        <!-- ============================================================= -->
        <!-- 3D COMPANION MASCOT HERO BANNER (MOCKUP ACCURATE)             -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lying 3D Cyber Mascot (Generated Asset matching user mockup) -->
            <ImageView
                android:id="@+id/ivHeroMascotLying"
                android:layout_width="145dp"
                android:layout_height="130dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/img_webmind_mascot_lying" />

            <!-- Speech Card: "Hi Karthik 👋\nWhat would you like to explore today?" -->
            <LinearLayout
                android:id="@+id/cardHeroSpeech"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hero_speech_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvHomeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Hi Karthik 👋"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="What would you like to explore today?"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- 4 QUICK ACTION PILLS (HORIZONTAL ROW MATCHING MOCKUP)         -->
        <!-- ============================================================= -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Pill 0: GPT Mode (Free Guest) -->
                <LinearLayout
                    android:id="@+id/pillQuickGptMode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQuickGptModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="GPT Mode"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuickGptModeSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Free Guest"
                            android:textColor="#10B981"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pill 1: Search something -->
                <LinearLayout
                    android:id="@+id/pillQuickSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        app:tint="#2563EB" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Search"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="something"
                            android:textColor="#6B7280"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pill 2: Compare products -->
                <LinearLayout
                    android:id="@+id/pillQuickCompare"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_compare"
                        app:tint="#2563EB" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Compare"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="products"
                            android:textColor="#6B7280"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pill 3: Summarize a page -->
                <LinearLayout
                    android:id="@+id/pillQuickSummarize"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_article"
                        app:tint="#059669" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Summarize"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="a page"
                            android:textColor="#6B7280"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pill 4: Track a price -->
                <LinearLayout
                    android:id="@+id/pillQuickTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tag"
                        app:tint="#EA580C" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Track"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="a price"
                            android:textColor="#6B7280"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pill 5: Live Web Browser -->
                <LinearLayout
                    android:id="@+id/pillQuickLiveWeb"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_pill"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_globe"
                        app:tint="#2563EB" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Live Web"
                            android:textColor="#111827"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="browser &amp; overlay"
                            android:textColor="#6B7280"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================= -->
        <!-- 6 PROMPT TILES (2 COLUMNS x 3 ROWS)                           -->
        <!-- ============================================================= -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="true">

            <!-- Tile 1: Find best laptops under 70k -->
            <LinearLayout
                android:id="@+id/tileLaptops"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="#2563EB" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Find best laptops\nunder 70k"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tile 2: Compare iPhone 16 vs S24 -->
            <LinearLayout
                android:id="@+id/tileComparePhones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_compare"
                    app:tint="#7C3AED" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Compare iPhone\n16 vs S24"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tile 3: Summarize this article -->
            <LinearLayout
                android:id="@+id/tileSummarize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_article"
                    app:tint="#059669" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Summarize\nthis article"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tile 4: Track gold price -->
            <LinearLayout
                android:id="@+id/tileGoldPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_gold_bars" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Track gold\nprice"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tile 5: Research about new AI models -->
            <LinearLayout
                android:id="@+id/tileAiModels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#D97706" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Research about\nnew AI models"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tile 6: More examples -->
            <LinearLayout
                android:id="@+id/tileMoreExamples"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_action_card_light"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_grid_view"
                    app:tint="#6B7280" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:text="More\nexamples"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>
        </GridLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================================= -->
    <!-- DOCKED BOTTOM COMMAND BAR (SNUG & FLUSH AT BOTTOM)            -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/llHomeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <!-- Blue Plus Button -->
        <ImageButton
            android:id="@+id/btnHomePlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_plus_blue"
            android:contentDescription="New Action"
            android:padding="9dp"
            android:src="@drawable/ic_plus"
            app:tint="#FFFFFF" />

        <!-- Pill Input Box -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_command_bar_light"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/etHomeWebQuery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@+id/llHomeInputActions"
                android:background="@null"
                android:hint="Ask anything or paste a link..."
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/llHomeInputActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnHomeVoiceMic"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voice Input"
                    android:padding="5dp"
                    android:src="@drawable/ic_mic"
                    app:tint="#4B5563" />

                <ImageButton
                    android:id="@+id/btnHomeSend"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_circle_black"
                    android:contentDescription="Search"
                    android:padding="7dp"
                    android:src="@drawable/ic_send"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
