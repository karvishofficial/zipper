<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Web Assistant AI Config"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Connect any LLM platform for autonomous web form filling &amp; browsing."
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Provider Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI PLATFORM"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnProvider"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="#1E293B"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- Model Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODEL NAME"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModelName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_box"
        android:hint="gemini-1.5-flash"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#475569"
        android:textSize="13sp" />

    <!-- Custom Base URL (Optional / for Custom provider) -->
    <LinearLayout
        android:id="@+id/layoutCustomUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM BASE URL"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_box"
            android:hint="https://api.yourprovider.com/v1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- API Key Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API KEY"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_box"
        android:hint="Paste your API key here..."
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#475569"
        android:textSize="13sp" />

    <!-- Live Status / Verification Message -->
    <TextView
        android:id="@+id/tvVerifyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:text="⚪ Not verified"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelApi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1E293B"
            android:text="Close"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClearApi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#334155"
            android:text="Clear"
            android:textColor="#EF4444"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnVerifyAndSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#059669"
            android:text="Verify &amp; Save"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
