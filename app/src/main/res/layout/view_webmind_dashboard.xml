<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerWebmindContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@+id/bottomNavBar"
    android:background="#F8F9FA"
    android:visibility="gone">

    <!-- Top App Bar for Webmind -->
    <RelativeLayout
        android:id="@+id/webmindTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Arrow (Returns to Agent tab) -->
            <ImageButton
                android:id="@+id/btnWebmindBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111827" />

            <!-- Globe Icon Badge -->
            <ImageView
                android:id="@+id/ivHeaderGlobeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Live Web Browser"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_globe"
                app:tint="#111827" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWebmindTopTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false"
                    android:text="Webmind"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWebmindTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="Research · Compare · Analyze"
                    android:textColor="#6B7280"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Action Icons: AI Mode Toggle Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnWebmindAiToggle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_filter_pill_black"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚡ AI: ON"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Webmind Content -->
    <FrameLayout
        android:id="@+id/flWebmindContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/webmindTopBar">

        <include
            android:id="@+id/screenWebmindHome"
            layout="@layout/view_webmind_home" />
    </FrameLayout>
</RelativeLayout>
